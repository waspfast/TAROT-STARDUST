name = "stardustworker"
main = "worker.js"
compatibility_date = "2025-01-01"

[[kv_namespaces]]
binding = "BOOKINGS"
# Reemplaza TU_KV_ID por el id real de tu namespace KV. NO subas el id real al repo.
id = "TU_KV_ID"

# --- Cupo atomico (D1) -----------------------------------------------
# Activado: el worker usa D1 (SQLite) para reservar sin Durable Objects.
# Si quitas el binding "DB", cae al respaldo KV (NO atomico).
[[d1_databases]]
binding = "DB"
database_name = "stardust-db"
# Reemplaza TU_D1_ID por el database_id real. NO lo subas al repo.
database_id = "TU_D1_ID"

[assets]
directory = "../admin"
binding = "ASSETS"
run_worker_first = ["/*"]

[vars]
ACCESS_TEAM_DOMAIN = "TU-EQUIPO.cloudflareaccess.com"
ACCESS_AUD = "TU-APPLICATION-AUDIENCE-TAG"
ADMIN_EMAILS = "tu-correo@ejemplo.com"
